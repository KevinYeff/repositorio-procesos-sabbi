ute.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="480" y="378" width="260" height="34" as="geometry"/></mxCell><mxCell id="arch_25" value="[API] /api/processes/[id]/versions&#10;→ route.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="260" height="44" as="geometry"/></mxCell><mxCell id="arch_26" value="[API] /api/search  → route.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="480" y="472" width="260" height="34" as="geometry"/></mxCell><mxCell id="arch_27" value="[API] /api/areas  → route.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="480" y="514" width="260" height="34" as="geometry"/></mxCell><mxCell id="arch_28" value="[SVC] ProcessService  → lib/services/process.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="300" height="34" as="geometry"/></mxCell><mxCell id="arch_29" value="[SVC] VersionService  → lib/services/version.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="820" y="164" width="300" height="34" as="geometry"/></mxCell><mxCell id="arch_30" value="[SVC] SearchService  → lib/services/search.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="820" y="208" width="300" height="34" as="geometry"/></mxCell><mxCell id="arch_31" value="[SVC] AuditService  → lib/services/audit.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="820" y="252" width="300" height="34" as="geometry"/></mxCell><mxCell id="arch_32" value="[SVC] AreaService  → lib/services/area.ts"