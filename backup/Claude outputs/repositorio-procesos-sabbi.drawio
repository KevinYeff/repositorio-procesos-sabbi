=left;verticalAlign=middle;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="tree_2" value="repo/&#10;├─ app/&#10;│  ├─ (auth)/login/page.tsx&#10;│  ├─ (app)/&#10;│  │  ├─ layout.tsx&#10;│  │  ├─ page.tsx                 # dashboard&#10;│  │  ├─ buscar/page.tsx&#10;│  │  ├─ areas/[slug]/page.tsx&#10;│  │  └─ procesos/&#10;│  │     ├─ nuevo/page.tsx&#10;│  │     └─ [id]/&#10;│  │        ├─ page.tsx           # ver proceso&#10;│  │        └─ editar/page.tsx&#10;│  └─ api/&#10;│     ├─ auth/[...nextauth]/route.ts&#10;│     ├─ processes/route.ts&#10;│     ├─ processes/[id]/route.ts&#10;│     ├─ processes/[id]/versions/route.ts&#10;│     ├─ search/route.ts&#10;│     └─ areas/route.ts&#10;├─ components/  StepBuilder, FlowViewer, ProcessCard, SearchBar,&#10;│              VersionHistory, DiffViewer, RequiredFields&#10;├─ lib/&#10;│  ├─ auth.ts     db.ts&#10;│  ├─ mermaid.ts  # arma el diagrama desde los pasos (cliente)&#10;│  └─ services/  process.ts version.ts search.ts audit.ts area.ts&#10;├─ prisma/schema.prisma&#10;├─ middleware.ts&#10;├─ .env.example        # AUTH_MICROSOFT_ENTRA_ID_*, DATABASE_URL&#10;├─ next.config.js  tailwind.config.ts  tsconfig.json  package.json&#10;└─ vercel.json (opcional)&#10;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E1E1E;strokeColor=#000000;align=left;verticalAlign=top;fontColor=#D4D4D4;fontFamily=Courier New;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="780" height="640" as="geometry"/></mxCell><mxCell id="tree_3" value="ORDEN SUGERIDO DE GENERACIÓN&#10;1. Scaffold Next.js + TS + Tailwind + config Vercel.&#10;2. prisma/schema.prisma (pág. 02) + lib/db.ts + seed de áreas.&#10;3. Auth Entra ID/M365: lib/auth.ts, middleware.ts, ruta nextauth.&#10;4. Servicios lib/services/* (CRUD + versión + búsqueda + audit).&#10;5. API route handlers.&#10;6. lib/mermaid.ts (diagrama determinista desde pasos).&#10;7. Componentes UI + páginas (con marca Sabbi).&#10;8. .env.example + README + repo GitHub + deploy a Vercel." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="80" width="470" height="300" as="geometry"/></mxCell><mxCell id="tree_4" value="VARIABLES DE ENTORNO (.env.example)&#10;• AUTH_MICROSOFT_ENTRA_ID_ID / _SECRET / _ISSUER&#10;• AUTH_SECRET  (NextAuth)&#10;• DATABASE_URL  (proveedor Postgres por definir)&#10;• NEXT_PUBLIC_APP_URL&#10;&#10;Sin claves de IA: el producto no llama a ningún modelo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="470" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>