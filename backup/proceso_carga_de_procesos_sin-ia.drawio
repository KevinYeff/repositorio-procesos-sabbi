<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="carga-procesos-sabbi" name="Carga de un proceso nuevo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3040" pageHeight="820" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Repositorio de Procesos SABBI: flujo para cargar un proceso nuevo" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#334f1b;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1600" height="40" as="geometry"/></mxCell><mxCell id="l1" value="Colaborador" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=44;fillColor=#334f1b;strokeColor=#79a82d;fontColor=#f4f4ed;fontStyle=1;fontSize=13;fontFamily=Hanken Grotesk;swimlaneFillColor=#F4F4ED;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2960" height="200" as="geometry"/></mxCell><mxCell id="l2" value="Plataforma" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=44;fillColor=#334f1b;strokeColor=#79a82d;fontColor=#f4f4ed;fontStyle=1;fontSize=13;fontFamily=Hanken Grotesk;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="2960" height="170" as="geometry"/></mxCell><mxCell id="l3" value="Líder de área" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=44;fillColor=#334f1b;strokeColor=#79a82d;fontColor=#f4f4ed;fontStyle=1;fontSize=13;fontFamily=Hanken Grotesk;swimlaneFillColor=#F4F4ED;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="2960" height="190" as="geometry"/></mxCell><mxCell id="n1" value="Inicio: el colaborador ingresa a la plataforma" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#223311;strokeColor=#223311;fontColor=#f4f4ed;fontStyle=1;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n2" value="Autentica con cuenta Microsoft (Entra ID) y valida permisos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334f1b;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="170" height="80" as="geometry"/></mxCell><mxCell id="n3" value="Selecciona el área: Legal, Operaciones, Fondos, Inversiones, AI, Growth o Comercial" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n4" value="Crea un proceso nuevo: nombre y objetivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n5" value="Describe el proceso: responsables (áreas), entradas, salidas, herramientas. Puede adjuntar documentos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="980" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Diagrama el flujo en el editor visual (fácil de usar): pasos, decisiones y tipo de cada paso (transporte, captura, criterio, verificación)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="170" height="90" as="geometry"/></mxCell><mxCell id="n7" value="Redacta el resumen operativo, reglas de verificación y riesgos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="1420" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n8" value="Guarda el borrador y lo envía a revisión" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334f1b;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="1640" y="320" width="170" height="80" as="geometry"/></mxCell><mxCell id="d1" value="¿Campos requeridos completos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#c3ed74;strokeColor=#334f1b;strokeWidth=2;fontColor=#223311;fontStyle=1;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="1860" y="305" width="170" height="110" as="geometry"/></mxCell><mxCell id="n9" value="Completa la información que falta" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="1860" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n12" value="Revisa el proceso y su diagrama" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBE8;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="2080" y="500" width="170" height="80" as="geometry"/></mxCell><mxCell id="d2" value="¿Aprobado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#c3ed74;strokeColor=#334f1b;strokeWidth=2;fontColor=#223311;fontStyle=1;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="2300" y="485" width="170" height="110" as="geometry"/></mxCell><mxCell id="n13" value="Ajusta el proceso según los comentarios" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3E4;strokeColor=#79a82d;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="2300" y="140" width="170" height="80" as="geometry"/></mxCell><mxCell id="n14" value="Publica la versión y registra el cambio en el historial" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334f1b;strokeWidth=2;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="2520" y="320" width="170" height="80" as="geometry"/></mxCell><mxCell id="n15" value="Fin: proceso disponible en el repositorio con trazabilidad" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#223311;strokeColor=#223311;fontColor=#f4f4ed;fontStyle=1;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="2740" y="320" width="170" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="" edge="1" parent="1" source="n8" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="No, faltan datos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334f1b;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;fontColor=#334f1b;labelBackgroundColor=#FFFFFF;fontFamily=Hanken Grotesk;" edge="1" parent="1" source="d1" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334f1b;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;fontColor=#334f1b;labelBackgroundColor=#FFFFFF;fontFamily=Hanken Grotesk;" edge="1" parent="1" source="d1" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="" edge="1" parent="1" source="n12" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334f1b;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;fontColor=#334f1b;labelBackgroundColor=#FFFFFF;fontFamily=Hanken Grotesk;" edge="1" parent="1" source="d2" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334f1b;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;fontColor=#334f1b;labelBackgroundColor=#FFFFFF;fontFamily=Hanken Grotesk;" edge="1" parent="1" source="d2" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r1" value="Completa y reenvía" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#79a82d;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#3f5a1f;fontSize=11;fontStyle=1;labelBackgroundColor=#F4F4ED;fontFamily=Hanken Grotesk;" edge="1" parent="1" source="n9" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1945" y="110"/><mxPoint x="1065" y="110"/></Array></mxGeometry></mxCell><mxCell id="r2" value="Corrige y reenvía" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#79a82d;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#3f5a1f;fontSize=11;fontStyle=1;labelBackgroundColor=#F4F4ED;fontFamily=Hanken Grotesk;" edge="1" parent="1" source="n13" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2385" y="92"/><mxPoint x="1050" y="92"/></Array></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Formato estándar de cada proceso:&lt;/b&gt; objetivo, responsables, pasos, entradas, salidas, decisiones, herramientas involucradas, reglas de verificación y riesgos o excepciones. El editor visual permite diagramar y clasificar cada paso; no interviene ninguna IA. Cada publicación genera una nueva versión con su registro de cambios." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=14;spacingRight=14;fillColor=#EEF3E4;strokeColor=#79a82d;fontColor=#334f1b;fontSize=12;fontFamily=Hanken Grotesk;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1300" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>