        <mxCell id="t" value="Repositorio de Procesos SABBI: flujo para cargar un proceso nuevo" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#334f1b;fontFamily=Hanken Grotesk;" vertex="1" parent="1">
