  <diagram id="carga-procesos-sabbi" name="Carga de un proceso nuevo">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
